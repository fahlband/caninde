{
  "name": "caninde",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo da plataforma Caninde",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  }
}
