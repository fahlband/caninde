# Copie para .env e ajuste os valores. Nunca versione o arquivo .env.

# Banco de dados (docker-compose)
DATABASE_URL=postgresql://caninde:caninde@localhost:5432/caninde
# Banco temporário do Prisma para `db:migrate` e `db:check` (criado por infra/postgres/initdb)
SHADOW_DATABASE_URL=postgresql://caninde:caninde@localhost:5432/caninde_shadow

# Autenticação (Keycloak local; em produção, o Supabase)
AUTH_ISSUER_URL=http://localhost:8080/realms/caninde
AUTH_JWKS_URL=http://localhost:8080/realms/caninde/protocol/openid-connect/certs
AUTH_AUDIENCE=caninde-api

# API
API_PORT=3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
